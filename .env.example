# Local-only template. Replace these with a local/test setup before using database features.
# Do not leave these blank: lib/supabase/config.ts has a built-in fallback if values are absent.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-supabase-publishable-key
# Legacy alias supported by the app; normally leave empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public OAuth client IDs (optional for UI-only work).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_TELEGRAM_CLIENT_ID=
# Server-side aliases accepted by the public auth-config endpoint; these are client IDs, not secrets.
GOOGLE_CLIENT_ID=
TELEGRAM_CLIENT_ID=

# Public site/media/integration settings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_ORIGIN=
NEXT_PUBLIC_MEDIA_RU_ORIGIN=
NEXT_PUBLIC_BOOSTY_URL=
NEXT_PUBLIC_MONETIZATION_ENABLED=false
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_AD_PROVIDER=none
NEXT_PUBLIC_DIRECT_PLAYER_ENABLED=false

# Server-only secrets. Keep blank for UI-only development.
# NEVER prefix these with NEXT_PUBLIC_ and never use production values in local development.
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
SEO_INDEX_CRON_SECRET=
LEADERBOARD_CRON_SECRET=
DONATEPAY_API_TOKEN=
KODIK_TOKEN=
ALLOHA_API_TOKEN=
ANIMEBOX_EDGE_ORIGIN_SECRET=

# Optional local data path.
ANIMEBOX_DB_PATH=.data/animebox.sqlite
