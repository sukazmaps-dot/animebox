# /etc/nginx/snippets/animebox-proxy-common.conf

proxy_http_version 1.1;

# Vercel still routes the request as the canonical AnimeBox domain.
proxy_set_header Host youranimebox.com;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

# Harmless for ordinary HTTP and keeps upgrade-capable routes working.
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;

proxy_ssl_server_name on;
proxy_ssl_name cname.vercel-dns.com;
proxy_ssl_verify on;
proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

proxy_connect_timeout 8s;
proxy_send_timeout 75s;
proxy_read_timeout 75s;
proxy_redirect off;
