# AnimeBox Watch Together · coturn example
#
# Replace placeholders before starting.
# The value of static-auth-secret MUST be identical to WATCH_PARTY_TURN_SECRET
# in Vercel. Never commit the real secret.

listening-port=3478
tls-listening-port=443

fingerprint
use-auth-secret
static-auth-secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

realm=turn.youranimebox.com
server-name=turn.youranimebox.com

# If the server is behind NAT, set the public/private mapping, for example:
# external-ip=203.0.113.10/10.0.0.5

min-port=49160
max-port=49200

no-cli
no-loopback-peers
no-multicast-peers
stale-nonce=600

# TLS certificate for turns: on 443
cert=/etc/letsencrypt/live/turn.youranimebox.com/fullchain.pem
pkey=/etc/letsencrypt/live/turn.youranimebox.com/privkey.pem

# Modern TLS only.
no-tlsv1
no-tlsv1_1

# Keep UDP + TCP listeners enabled. The client tries direct/P2P first and can
# fall back to TURN UDP, TURN TCP or TURNS/TCP depending on configured URLs.
