# PeerJS signaling example.
# Run PeerServer on 127.0.0.1:9000 and terminate HTTPS here.
#
# IMPORTANT:
# TURN/TLS :443 cannot bind the same public IP:443 at the same time as nginx.
# For the strongest restrictive-network fallback, put TURN :443 on another
# public IP / VPS, or use an L4 TLS multiplexer.
# This file must be included inside nginx's http {} block. If Cloudflare sits
# in front of peer.youranimebox.com, first configure nginx real_ip with trusted
# Cloudflare ranges; otherwise these per-IP limits would group users by proxy.
limit_conn_zone $binary_remote_addr zone=peer_connections:10m;
limit_req_zone $binary_remote_addr zone=peer_handshakes:10m rate=12r/s;

server {
    listen 443 ssl;
    server_name peer.youranimebox.com;

    ssl_certificate     /etc/letsencrypt/live/peer.youranimebox.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/peer.youranimebox.com/privkey.pem;

    location /peerjs/ {
        # WebSocket upgrades stay counted as concurrent connections.
        limit_conn peer_connections 24;
        limit_req zone=peer_handshakes burst=24 nodelay;
        limit_conn_status 429;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }
}
