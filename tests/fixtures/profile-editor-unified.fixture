'use client';
import avatarImage from '@/public/ui/animebox-mascot.webp';
import bannerImage from '@/public/backgrounds/hero-fallback.webp';
import { StrictMode, useEffect, useRef, useState } from 'react';
import Surface from '@/components/profile/ProfileDirectEditSurface';
import Viewport from '@/components/profile/ProfileEditorViewport';
import Board from '@/components/profile/ProfileEditorShowcasePreview';
import Preview, { type ProfileEditorSection } from '@/components/profile/ProfileEditorLivePreview';
import { observeProfileEditorDock } from '@/lib/profile-editor-dock';

type Tile = ProfileEditorSection | 'showcase' | 'rewards';
const boardData = {
 layout:[{key:'favorites' as const,position:0,visible:true},{key:'watching' as const,position:1,visible:true}],
 favorites:Array.from({length:6},(_,i)=>({animeId:i,title:['Евангелион','Фрирен','Ван-Пис'][i%3],slug:null,posterUrl:bannerImage,genres:[],totalEpisodes:12,position:i})),
 watching:[],ratings:[],genres:[],activity:[],ratingSummary:{count:0,average:null}
};
function Harness(){
 const query=new URLSearchParams(window.location.search).get('tab');
 const initial: Tile = query==='avatar'||query==='banner'||query==='frame'||query==='style'||query==='showcase'||query==='rewards' ? query : 'profile';
 const [tab,setTab]=useState<Tile>(initial);
 const [panelOpen,setPanelOpen]=useState(initial!=='profile');
 const [showBoard,setShowBoard]=useState(false);
 const [name,setName]=useState('Имя пользователя');
 const [bio,setBio]=useState('Описание профиля');
 const [color,setColor]=useState('#70618c');
 const [frame,setFrame]=useState<string|null>(null);
 const [savedName,setSavedName]=useState(name);
 const [savedBio,setSavedBio]=useState(bio);
 const [savedColor,setSavedColor]=useState(color);
 const [savedFrame,setSavedFrame]=useState(frame);
 const savebarRef=useRef<HTMLDivElement|null>(null);
 const dirty=name!==savedName||bio!==savedBio||color!==savedColor||frame!==savedFrame;
 useEffect(()=>{if(!savebarRef.current)return;return observeProfileEditorDock(savebarRef.current)},[dirty]);
 function choose(next:Tile){if(tab===next&&panelOpen){setPanelOpen(false);return;}setTab(next);setPanelOpen(true);}
 function navigate(section:ProfileEditorSection){choose(section);}
 useEffect(()=>{
  const onKey=(event:KeyboardEvent)=>{if(event.key==='Escape'&&panelOpen)setPanelOpen(false);};
  window.addEventListener('keydown',onKey);return()=>window.removeEventListener('keydown',onKey);
 },[panelOpen]);
 return <main className="profile-editor-v13" data-editor-tab={tab} data-editor-layout="modal">
 <section className="profile-editor-v13__shell profile-editor-v40__shell" role="dialog" aria-modal="true" aria-label="Редактор профиля">
 <header className="profile-editor-v13__header profile-editor-v40__header">
 <div className="profile-editor-v31__header-title"><button type="button" aria-label="Закрыть редактор">×</button><h1>Редактор профиля</h1></div>
 <span className="profile-editor-v31__status">{dirty?'● Не сохранено':'✓ Сохранено'}</span></header>
 <div className="profile-editor-v40__workbench">
 <nav className="profile-editor-v40__tiles" aria-label="Настройки профиля">
 {([['profile','Имя'],['avatar','Аватар'],['banner','Баннер'],['frame','Рамка'],['style','Оформление'],['showcase','Витрина'],['rewards','Награды']] as const)
 .map(([section,label])=><button type="button" aria-label={label} key={section} data-selected={tab===section&&panelOpen} onClick={()=>choose(section)}>
 <span aria-hidden="true">◇</span><small>{label}</small></button>)}
 </nav>
 <section className="profile-editor-v40__stage">
 <div className="profile-editor-v40__stage-header"><span>ТВОЙ ПРОФИЛЬ</span><button>Развернуть ↗</button></div>
 <Preview full createdAt="2021-02-19T00:00:00Z" username={name} bio={bio} avatarUrl={avatarImage}
 bannerUrl={bannerImage} bannerColor={color} bannerStyle="soft" premiumActive={false} frameKey={frame}
 onNavigate={navigate} onUsernameChange={setName} onBioChange={setBio}/>
 <button type="button" className="profile-editor-v40__board-toggle" onClick={()=>setShowBoard(v=>!v)}>Показать витрину</button>
 </section>
 <aside className="profile-editor-v40__board" data-mobile-visible={showBoard}>
 <Board data={boardData} loading={false} error="" onConfigure={()=>choose('showcase')} onRetry={()=>{}}/></aside>
 <aside className="profile-editor-v40__popover" hidden={!panelOpen} aria-label="Настройки выбранного элемента">
 <header><h2>{tab}</h2><button type="button" aria-label="Закрыть настройки" onClick={()=>setPanelOpen(false)}>×</button></header>
 <fieldset className="profile-editor-v31__settings profile-editor-v40__panel-content">
 <div className="profile-editor-v19__direct-tab" hidden={tab==='showcase'||tab==='rewards'||tab==='style'}>
 <Surface showPreview={false} compact section={tab==='showcase'||tab==='rewards'?'profile':tab==='style'?'profile':tab}
 username={name} bio={bio} avatarUrl={avatarImage} baseAvatarUrl={avatarImage} bannerUrl={null} baseBannerUrl={null}
 bannerColor={color} bannerColorMode="manual" premiumActive={false} avatarPremiumOverride={false} bannerPremiumOverride={false}
 avatarBusy={false} bannerBusy={false} canRemoveAvatar={false} canRemoveBanner={false} selectedFrameDraft={frame}
 onFrameChange={setFrame} onFrameLoaded={setFrame} onSectionChange={navigate} onUsernameChange={setName} onBioChange={setBio}
 onBannerColorChange={next=>setColor(next)} onAvatarFile={()=>{}} onBannerFile={()=>{}} onRemoveAvatar={()=>{}}
 onRemoveBanner={()=>{}} onUseBaseAvatar={()=>{}} onUseBaseBanner={()=>{}} onOpenPremium={()=>choose('style')}/>
 </div>
 {tab==='style'&&<p>Дополнительные настройки Premium</p>}
 {tab==='showcase'&&<p>Настройка витрины</p>}
 {tab==='rewards'&&<p>Награды</p>}
 </fieldset></aside>
 </div>
 {dirty&&<div ref={savebarRef} className="profile-editor-v13__mobile-save profile-editor-v18__savebar profile-editor-v40__savebar" data-visible="true">
 <span className="profile-editor-v18__savebar-copy"><strong>Несохранённые изменения</strong></span>
 <button type="button" onClick={()=>{setName(savedName);setBio(savedBio);setColor(savedColor);setFrame(savedFrame);}}>Сбросить</button>
 <button type="button" data-editor-save onClick={()=>{setSavedName(name);setSavedBio(bio);setSavedColor(color);setSavedFrame(frame);}}>Сохранить</button>
 </div>}
 </section></main>;
}
export default function Fixture(){return <StrictMode><Viewport><Harness/></Viewport></StrictMode>;}
