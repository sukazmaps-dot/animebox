'use client';
import avatarImage from '@/public/ui/animebox-mascot.webp';
import bannerImage from '@/public/backgrounds/hero-fallback.webp';
import { StrictMode, useEffect, useState } from 'react';
import Navigation from '@/components/profile/ProfileEditorNavigation';
import Surface from '@/components/profile/ProfileDirectEditSurface';
import Viewport from '@/components/profile/ProfileEditorViewport';
import Board from '@/components/profile/ProfileEditorShowcasePreview';
import ProfileMediaModal from '@/components/profile/ProfileMediaModal';
import Preview, { type ProfileEditorSection } from '@/components/profile/ProfileEditorLivePreview';
import { useProfileEditorAnchors } from '@/hooks/useProfileEditorAnchors';
import { profileEditorAnchor } from '@/lib/profile-editor-navigation';
import { observeProfileEditorDock } from '@/lib/profile-editor-dock';

const image=avatarImage;
function Harness(){
 const [previewOpen,setPreviewOpen]=useState(false);
 const [tab,setTab]=useState<'profile'|'style'|'showcase'|'rewards'>('profile');
 const [name,setName]=useState('Имя пользователя');
 const [bio,setBio]=useState('Описание профиля');
 const [color,setColor]=useState('#70618c');
 const [frame,setFrame]=useState<string|null>(null);
 const initial=typeof window==='undefined'?'name':profileEditorAnchor(new URLSearchParams(window.location.search).get('tab'));
 const {activeAnchor,navigateToAnchor}=useProfileEditorAnchors(tab==='profile',initial);
 useEffect(()=>observeProfileEditorDock(document.querySelector<HTMLElement>('.profile-editor-v18__savebar')),[]);
 function navigate(section:ProfileEditorSection){setTab('profile');navigateToAnchor(profileEditorAnchor(section));}
 return <main className="profile-editor-v13" data-editor-tab={tab}><section className="profile-editor-v13__shell">
  <header className="profile-editor-v13__header"><div className="profile-editor-v31__header-title"><button type="button" aria-label="Закрыть редактор">×</button><h1>Редактор профиля</h1></div><span className="profile-editor-v31__status">Не сохранено</span></header>
  <div className="profile-editor-v31__live-preview"><button type="button" className="profile-editor-v31__expand" onClick={()=>setPreviewOpen(true)}>Развернуть превью</button><Preview full createdAt="2021-02-19T00:00:00Z" username={name} bio={bio} avatarUrl={image} bannerUrl={bannerImage} bannerColor={color} bannerStyle="soft" premiumActive={false} frameKey={frame} onNavigate={navigate}/></div>
  <aside className="profile-editor-v33__board" hidden={tab!=='profile'}><Board data={{layout:[{key:'favorites',position:0,visible:true},{key:'watching',position:1,visible:true}],favorites:Array.from({length:6},(_,i)=>({animeId:i,title:['Евангелион','Фрирен','Ван-Пис'][i%3],slug:null,posterUrl:bannerImage,genres:[],totalEpisodes:12,position:i})),watching:[],ratings:[],genres:[],activity:[],ratingSummary:{count:0,average:null}}} loading={false} error="" onConfigure={()=>setTab('showcase')} onRetry={()=>{}}/></aside>
  <Navigation activeTab={tab} onNavigate={setTab}/>
  <fieldset className="profile-editor-v31__settings">
   <div className="profile-editor-v19__direct-tab" hidden={tab!=='profile'}>
    <nav className="profile-editor-v32__anchors" data-profile-anchor-nav aria-label="Настройки профиля">
     {(['name','avatar','banner','frame'] as const).map(value=><button key={value} data-profile-anchor-link={value} aria-current={activeAnchor===value?'location':undefined} onClick={()=>navigateToAnchor(value)}>{{name:'Имя',avatar:'Аватар',banner:'Баннер',frame:'Рамка'}[value]}</button>)}
    </nav>
    <Surface showPreview={false} section="profile" username={name} bio={bio} avatarUrl={image} baseAvatarUrl={image} bannerUrl={null} baseBannerUrl={null} bannerColor={color} bannerColorMode="manual" premiumActive={false}
     avatarPremiumOverride={false} bannerPremiumOverride={false} avatarBusy={false} bannerBusy={false} canRemoveAvatar={false} canRemoveBanner={false}
     selectedFrameDraft={frame} onFrameChange={setFrame} onSectionChange={navigate} onUsernameChange={setName} onBioChange={setBio} onBannerColorChange={setColor}
     onAvatarFile={()=>{}} onBannerFile={()=>{}} onRemoveAvatar={()=>{}} onRemoveBanner={()=>{}} onUseBaseAvatar={()=>{}} onUseBaseBanner={()=>{}} onOpenPremium={()=>setTab('style')}/>
   </div>
   {tab!=='profile'&&<p>Другой раздел</p>}
  </fieldset>
  <div className="profile-editor-v13__mobile-save profile-editor-v18__savebar" data-visible="true"><span className="profile-editor-v18__savebar-copy"><strong>Не сохранено</strong></span><button>Сбросить</button><button data-editor-save>Сохранить</button></div>
 </section>
 {previewOpen&&<ProfileMediaModal busy={false} onClose={()=>setPreviewOpen(false)} labelledBy="qa-preview-title"><section className="profile-editor-v31__preview-dialog"><header><h2 id="qa-preview-title">Предпросмотр профиля</h2><button onClick={()=>setPreviewOpen(false)}>Закрыть</button></header><Preview expanded username={name} bio={bio} avatarUrl={image} bannerUrl={bannerImage} bannerColor={color} bannerStyle="soft" premiumActive={false} onNavigate={navigate}/><Board data={null} loading={false} error="" onConfigure={()=>{setPreviewOpen(false);setTab('showcase');}} onRetry={()=>{}}/></section></ProfileMediaModal>}
 </main>;
}
export default function Fixture(){return <StrictMode><Viewport><Harness/></Viewport></StrictMode>;}
