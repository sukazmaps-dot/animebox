'use client';
import '../patch17-6-home-recommendation-actions.css';
import '../patch18-6-3-loading-ux.css';
import '../home-visual-repair.css';
import '../patch29-1-home-mobile.css';
import '../patch30-0-home-streaming.css';
import HomeHeroCarousel from '@/components/HomeHeroCarousel';
import HomeAnimeRail from '@/components/HomeAnimeRail';
import HomeContinueWatching from '@/components/HomeContinueWatching';
const items = Array.from({length:10}, (_,i)=>({id:100+i, title:{russian:i===0?'Провожающая в последний путь Фрирен':`Невероятное приключение героя в другом мире — сезон ${i+1}`},mobileHeroPosition:{x:60,y:15},genres:['Adventure'],score:9.1,episodes:24,format:'TV',startDate:{year:2026},bannerImage:`https://qa-images.test/banner-${i}.jpg`,mobileHeroImage:`https://qa-images.test/portrait-${i}.jpg`,coverImage:{extraLarge:`https://qa-images.test/cover-${i}.jpg`}}));
export default function QAHome(){return <div className="home-page"><div className="home-grid home-grid--main"><div className="main-column"><HomeHeroCarousel popular={items} ongoing={[]} /><HomeContinueWatching items={items.slice(0,2).map(anime=>({anime:{...anime,lastViewedAt:1,viewCount:1},episode:7,resumeSeconds:33,completedEpisodes:6,totalEpisodes:24}))} /><section className="section home-catalog-section"><div className="section-head"><h2 className="section-title">Популярное</h2></div><HomeAnimeRail items={items} ariaLabel="Популярные аниме" watchedEpisodes={new Map([[100,7]])}/></section></div></div></div>}
